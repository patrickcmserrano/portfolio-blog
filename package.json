{
	"name": "skeleton-portifolio-blog",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"clean": "powershell -Command \"Start-Process powershell -ArgumentList '-NoProfile -Command Remove-Item -Recurse -Force ./node_modules, ./dist, ./build' -Verb RunAs\""
	},
	"devDependencies": {
		"@playwright/test": "^1.28.1",
		"@skeletonlabs/skeleton": "2.11.0",
		"@skeletonlabs/tw-plugin": "0.4.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@tailwindcss/typography": "^0.5.16",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^4.0.0",
		"@types/eslint": "^9.6.0",
		"@types/marked": "^5.0.2",
		"@types/node": "22.13.10",
		"autoprefixer": "10.4.20",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"jsdom": "^26.0.0",
		"postcss": "8.5.3",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"svelte": "^4.2.7",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^5.4.14",
		"vite-plugin-tailwind-purgecss": "0.3.5",
		"vitest": "^2.0.0"
	},
	"dependencies": {
		"dompurify": "^3.2.4",
		"highlight.js": "11.11.1",
		"marked": "^15.0.7",
		"prettier-plugin-tailwindcss": "^0.6.11"
	}
}
